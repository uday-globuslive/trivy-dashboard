# Artifactory Type Configuration
# Choose 'nexus' or 'jfrog' based on your artifact repository
ARTIFACTORY_TYPE=nexus

# Nexus Repository Configuration (used when ARTIFACTORY_TYPE=nexus)
NEXUS_URL=http://10.11.53.12:8081
NEXUS_USERNAME=sv-sbom
NEXUS_PASSWORD=sbom@sbom
NEXUS_REPOSITORY=mccamish_sbom

# Generic Nexus artifact pattern settings (for dashboard - reads Trivy reports)
NEXUS_GROUP_ID=com.mccamish
NEXUS_ARTIFACT_SUFFIX=-trivy-report
NEXUS_VERSION_PREFIX=1.0.0-
NEXUS_ASSET_EXTENSION=json
NEXUS_TIMEOUT=30

# JFrog Artifactory Configuration (used when ARTIFACTORY_TYPE=jfrog)
# Example: https://qusw.jfrog.io for erwindm project
JFROG_URL=https://your-jfrog-instance.jfrog.io
JFROG_USERNAME=your-jfrog-username
JFROG_PASSWORD=your-jfrog-password
JFROG_REPOSITORY=your-jfrog-sbom-repository

# Generic JFrog artifact pattern settings (for dashboard - reads Trivy reports)
JFROG_GROUP_ID=com.yourcompany
JFROG_ARTIFACT_SUFFIX=-trivy-report
JFROG_VERSION_PREFIX=1.0.0-
JFROG_ASSET_EXTENSION=json
JFROG_TIMEOUT=30

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=true
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
SECRET_KEY=your-secret-key-change-in-production

# Dashboard Configuration
CACHE_TTL=300
REFRESH_INTERVAL=600
MAX_SCAN_HISTORY=100
MAX_SCANS_PER_PROJECT=50
VULNERABILITY_RETENTION_DAYS=90
DEBUG_DASHBOARD=false
DEFAULT_PAGE_SIZE=10

# Chart Configuration
DEFAULT_CHART_THEME=plotly
CHART_HEIGHT=400

# Security Configuration
SECURE_HEADERS=true
CSRF_ENABLED=true
ENABLE_AUTH=false
SESSION_TIMEOUT_HOURS=8

# Performance Configuration
ENABLE_CACHING=true
MAX_WORKERS=4

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/dashboard.log
