# Nexus Repository Configuration
NEXUS_URL=http://10.11.53.12:8081
NEXUS_USERNAME=sv-sbom
NEXUS_PASSWORD=sbom@sbom
NEXUS_REPOSITORY=mccamish_sbom

# Generic Nexus artifact pattern settings (customize for your Jenkins upload pattern)
NEXUS_GROUP_ID=com.mccamish
NEXUS_ARTIFACT_SUFFIX=.sbom
NEXUS_VERSION_PREFIX=1.0.0-
NEXUS_ASSET_EXTENSION=json

# Trivy conversion settings
TRIVY_REPORT_SUFFIX=-trivy-report

# Additional pattern matching for SBOM discovery
NEXUS_SEARCH_PATTERN=*.json
NEXUS_PATH_CONTAINS=.sbom

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=your-secret-key-change-in-production

# Dashboard Configuration
CACHE_TTL=300
DATA_REFRESH_INTERVAL=600
MAX_SCAN_HISTORY=100

# Security Configuration
SECURE_HEADERS=true
CSRF_ENABLED=true

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/dashboard.log
