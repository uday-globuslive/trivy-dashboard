# Nexus Repository Configuration for SBOM Conversion Scripts
NEXUS_URL=http://your-nexus-server:8081
NEXUS_USERNAME=your-username
NEXUS_PASSWORD=your-password
NEXUS_REPOSITORY=your-sbom-repository

# SBOM file identification (what scripts convert FROM)
NEXUS_ARTIFACT_SUFFIX=.sbom
NEXUS_ASSET_EXTENSION=json

# Trivy report suffix (what scripts convert TO)
TRIVY_REPORT_SUFFIX=-trivy-report
